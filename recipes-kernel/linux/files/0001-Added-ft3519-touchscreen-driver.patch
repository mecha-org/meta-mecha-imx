index 000000000000..b656e0abcb9c
--- /dev/null
+++ b/drivers/input/touchscreen/focaltech_touch/focaltech_proximity.c
@@ -0,0 +1,827 @@
+/*
+ *
+ * FocalTech TouchScreen driver.
