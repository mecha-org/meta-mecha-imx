From 5edc9e640e6671e4d7779d4709c315cbe92d7db8 Mon Sep 17 00:00:00 2001
From: Pratham Malaviya <prathamm@mechasystems.com>
Date: Wed, 2 Jul 2025 16:06:49 +0530
Subject: [PATCH] dts: added usdhc3 reset pinmux

This patch adds the reset pinmux for usdhc3

Signed-off-by: Pratham Malaviya <prathamm@mechasystems.com>

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-mecha-comet-m-gen6.dts b/arch/arm64/boot/dts/freescale/imx8mp-mecha-comet-m-gen6.dts
index 2dc44f5c8803..ff11aa9cbff8 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-mecha-comet-m-gen6.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-mecha-comet-m-gen6.dts
@@ -618,6 +618,7 @@ MX8MP_IOMUXC_SD2_CD_B__GPIO2_IO12		0x1c4
 
 	pinctrl_usdhc3: usdhc3grp {
 		fsl,pins = <
+			MX8MP_IOMUXC_NAND_READY_B__USDHC3_RESET_B	0x1d1
 			MX8MP_IOMUXC_NAND_WE_B__USDHC3_CLK		0x190
 			MX8MP_IOMUXC_NAND_WP_B__USDHC3_CMD		0x1d0
 			MX8MP_IOMUXC_NAND_DATA04__USDHC3_DATA0		0x1d0
@@ -634,6 +635,7 @@ MX8MP_IOMUXC_NAND_CE1_B__USDHC3_STROBE		0x190
 	
 	pinctrl_usdhc3_100mhz: usdhc3-100mhzgrp {
 		fsl,pins = <
+			MX8MP_IOMUXC_NAND_READY_B__USDHC3_RESET_B	0x1d1
 			MX8MP_IOMUXC_NAND_WE_B__USDHC3_CLK		0x194
 			MX8MP_IOMUXC_NAND_WP_B__USDHC3_CMD		0x1d4
 			MX8MP_IOMUXC_NAND_DATA04__USDHC3_DATA0		0x1d4
@@ -650,6 +652,7 @@ MX8MP_IOMUXC_NAND_CE1_B__USDHC3_STROBE		0x190
 
 	pinctrl_usdhc3_200mhz: usdhc3-200mhzgrp {
 		fsl,pins =  <
+			MX8MP_IOMUXC_NAND_READY_B__USDHC3_RESET_B	0x1d1
 			MX8MP_IOMUXC_NAND_WE_B__USDHC3_CLK		0x196
 			MX8MP_IOMUXC_NAND_WP_B__USDHC3_CMD		0x1d6
 			MX8MP_IOMUXC_NAND_DATA04__USDHC3_DATA0		0x1d6
-- 
2.25.1

