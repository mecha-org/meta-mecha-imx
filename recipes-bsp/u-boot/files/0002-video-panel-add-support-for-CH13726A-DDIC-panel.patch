+};
+
+U_BOOT_DRIVER(ch13726a_panel) = {
+	.name 		= "ch13726a_panel",
+	.id 		= UCLASS_PANEL,
+	.of_match	= ch13726a_panel_ids,
+	.ops 		= &ch13726a_panel_ops,
+	.probe 		= ch13726a_panel_probe,
+	.plat_auto 	= sizeof(struct mipi_dsi_panel_plat),
+	.priv_auto 	= sizeof(struct ch13726a_panel_priv),
+};
