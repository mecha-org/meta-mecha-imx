index 57d788406af..c63f4b79770 100644
--- a/drivers/video/Kconfig
+++ b/drivers/video/Kconfig
@@ -537,6 +537,14 @@ config VIDEO_LCD_RAYDIUM_RM67191
 	Say Y here if you want to enable support for Raydium RM68200
 	1080x1920 DSI video mode panel.
 
+config VIDEO_AMOLED_DDIC_CH13726A
+	bool "DDIC_13726A DSI panel support"
+	depends on VIDEO
+	select VIDEO_MIPI_DSI
+	help
+	Say Y here if you want to enable support for DDIC_13726A
+	1080x1240 DSI video mode panel.
+
